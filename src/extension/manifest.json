{  
  "manifest_version": 3,
  "name": "PrivacyFirewall",
  "version": "0.1.2",
  "description": "Prevent pasting secrets and PII into AI tools. 100% local. No data leaves your machine.",
  
  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.xethub.hf.co/*"
  ],
  
  "background": {
    "scripts": ["background.js"]
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/pw16.png",
      "48": "icons/pw48.png"
    }
  },
  
  "icons": {
    "16": "icons/pw16.png",
    "48": "icons/pw48.png"
  },
  
  "options_page": "ui/settings.html",
  
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "privacyfirewall@privacyshield-ai.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}